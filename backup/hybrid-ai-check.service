# ---------------------------------------------------------------------------
# FILE: backup/hybrid-ai-check.service
# PURPOSE (plain English):
#   Runs a monthly integrity check against the backup repository, reading a
#   random 5% of the stored data and confirming it decrypts and matches its
#   checksums.
#
#   WHY THIS IS SEPARATE from the nightly backup: verification downloads data,
#   which is slow. You do not want it delaying your nightly run. But a backup
#   nobody has ever verified is a hypothesis, not a backup -- so it runs on its
#   own monthly schedule.
# ---------------------------------------------------------------------------
[Unit]
Description=hybrid-ai backup integrity verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/backup/backup.sh --check
TimeoutStartSec=6h

Nice=19
IOSchedulingClass=idle
CPUWeight=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__REPO_DIR__
# The leading '-' makes systemd tolerate the path not existing rather than
# refusing to start the unit. install.sh creates it; this is the backstop.
ReadWritePaths=-%h/.cache/restic
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
