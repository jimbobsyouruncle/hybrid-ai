# ---------------------------------------------------------------------------
# FILE: .env.example
# PURPOSE (plain English):
#   A reference copy showing every setting the project uses. This file is SAFE
#   to commit because it contains no real credentials -- only placeholders.
#
#   You do NOT need to copy or edit this file. Running ./install.sh generates a
#   real .env for you, prompting for anything it cannot work out by itself.
#   This exists so you can see, at a glance, what the system expects.
#
#   The real .env is gitignored and created with mode 0600 (readable only by
#   your user account). Never commit it.
# ---------------------------------------------------------------------------
ENV_VERSION=3

# --- Host paths (optional relocation) --------------------------------------
# Every host path this project uses is resolved in ONE place,
# scripts/lib/hybrid-ai-env.sh, from these named settings:
#   HYBRID_AI_APP_DIR   program/repository directory    (default: repo dir)
#   HYBRID_AI_ENV_FILE  LAYOUT file: paths and ids only (default: $HYBRID_AI_APP_DIR/.env)
#   HYBRID_AI_STACK_ENV_FILE  STACK file: passed to compose --env-file, holds secrets
#                       (default: the resolved HYBRID_AI_ENV_FILE)
#   HYBRID_AI_DATA_DIR  durable data                    (default: repo dir)
#   HYBRID_AI_LOG_DIR   logs                            (default: repo dir)
#   HYBRID_AI_WORK_DIR  backup/restore scratch          (default: repo dir)
# Resolution order is: the process environment, then this file (parsed, NEVER
# sourced), then the default. Leave them commented to keep the default layout.
# A set value must be an absolute path with no whitespace, ':' or ','.
# Example -- a split layout for a dedicated system account:
#HYBRID_AI_APP_DIR=/opt/hybrid-ai
#HYBRID_AI_DATA_DIR=/var/lib/hybrid-ai
#HYBRID_AI_ENV_FILE=/etc/hybrid-ai/hybrid-ai.env
#HYBRID_AI_STACK_ENV_FILE=/etc/hybrid-ai/stack.env
#HYBRID_AI_LOG_DIR=/var/log/hybrid-ai
#HYBRID_AI_WORK_DIR=/var/lib/hybrid-ai/work

# LAN IP or hostname your browser uses to reach the Pi
OPENHANDS_SANDBOX_HOST=

# --- Local control plane (Raspberry Pi) ------------------------------------
# Kernel-enforced Docker memory caps. install.sh sizes these from your actual
# RAM. (The old OLLAMA_MAX_VRAM is gone: it never worked and was removed from
# Ollama upstream.)
OLLAMA_MEM_LIMIT=11264m
WEBUI_MEM_LIMIT=3072m

# CPU shares. Leaving a core free keeps the web UI responsive while a model
# is generating.
OLLAMA_CPUS=3.5
WEBUI_CPUS=2.0

# Ollama caps EVERY model at 4096 tokens unless told otherwise, silently
# truncating long chats and RAG context. Larger values cost KV cache memory.
OLLAMA_CONTEXT_LENGTH=16384

OLLAMA_FLASH_ATTENTION=1
# f16 is the default. q8_0 halves KV cache memory, but quantised V cache
# REQUIRES flash attention to be active -- when Ollama auto-disables flash
# attention for an unsupported model architecture, the runner panics instead
# of degrading. Opt in only after confirming your model works with it.
OLLAMA_KV_CACHE_TYPE=f16

# Container image pins. Explicit versions, never :latest, so a `pull` cannot
# swap the image underneath you. Bump deliberately.
# NOTE: OLLAMA_CONTEXT_LENGTH above is honoured only by newer Ollama servers.
# install.sh checks this after start and warns.
OLLAMA_IMAGE=ollama/ollama:0.34.4
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4

# Serve one request at a time. A Pi has no headroom for parallelism.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# How long an idle model stays resident. Longer means faster follow-up
# questions; install.sh uses 30m on a 16 GB board.
OLLAMA_KEEP_ALIVE=30m

# --- Open WebUI -------------------------------------------------------------
# Signs your login cookies. install.sh generates this once with
# `openssl rand -hex 32` and then reuses it forever. If this value ever
# changes, every user is logged out.
WEBUI_SECRET_KEY=generated_automatically_do_not_set_manually

# Require login. Leave as true.
WEBUI_AUTH=true

# Model used to turn your documents into searchable vectors. Runs locally.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Leave false unless you deliberately want to add external API providers.
ENABLE_OPENAI_API=false

# --- Local domain & reverse proxy ------------------------------------------
# The primary DNS domain resolved by your Pi-hole. Caddy uses this variable
# to automatically bind local subdomains (e.g. openhands.yourhostname.com, 
# hermes.yourhostname.com, status.yourhostname.com). Prompted during ./install.sh.
LOCAL_DOMAIN=yourhostname.com

# --- Opt-in TLS / ACME (docs/tls-acme-design.md) ---------------------------
# Off by default. With TLS off, install.sh writes the same Caddyfile and
# compose file it always has, and prints the same URLs. Set TLS_ENABLED=1, or
# run ./install.sh --tls (preview with --dry-run). TLS_DOMAIN is the public
# certificate name; LOCAL_DOMAIN keeps its meaning for the http:// fallback.
TLS_ENABLED=no
TLS_DOMAIN=daemonhub.dev
ACME_EMAIL=you@example.com
# staging | production | an https:// ACME directory URL. Staging is the default
# because it has no rate limit; switch to production once issuance works.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# dns | http | tlsalpn. DNS-01 is the only method that can issue a wildcard.
TLS_VALIDATION=dns
# cloudflare | rfc2136.
ACME_DNS_PROVIDER=cloudflare
# PATH to the operator-owned credential file. This is a path, never the token:
# no token value belongs in this file, in .env, in an argument or in git.
# The file must be root-owned, mode 0600, outside the repo, under this path:
HYBRID_AI_TLS_TOKEN_FILE=/etc/hybrid-ai/acme/cloudflare_dns_token
# Derived by install.sh from TLS_DOMAIN; written for the status page.
TLS_HOSTS=
# Keep Caddy's certificate management on for every mode. `off` disables issuance
# entirely, so a DNS-01 install would report success and issue no certificate.
# disable_redirects leaves the explicit http:// block as the one 308 redirect.
ACME_AUTO_HTTPS=disable_redirects
# The Caddy image built with the DNS provider modules (see caddy/Dockerfile).
CADDY_IMAGE=hybrid-ai-caddy:2.11.7-dns
# Login gate for the *.daemonhub.dev HTTPS sites (apex, hermes., status. and the
# wildcard). off by default: the rendered Caddyfile is then byte-identical to
# the one without the gate, and only the http://*.jarvis.lan names are reachable
# during the transition. Set AUTH_ENABLED=on, then give a user name, a bcrypt
# HASH and a cookie secret. Generate the hash with:
#   docker run --rm caddy:2.11-alpine caddy hash-password
# Paste the `caddy hash-password` output AS-IS: the installer escapes it on
# write, so do NOT add the `$$` yourself.
#
# The gate now forward_auths to a small auth service that serves a login page
# and issues a signed session cookie. One login covers apex, hermes., status.
# and the wildcard (the cookie's Domain is TLS_DOMAIN). Generate the cookie
# signing key once, by hand, into this 0600 file:
#   openssl rand -hex 32
#
# `$` in an env-file value is interpolated by Docker Compose, so the installer
# writes the user, the hash and the cookie secret with every `$` doubled (`$$`).
# Compose collapses it back to one `$` for the container. A bcrypt hash
# (`$2a$14$...`) left raw would lose its `$` fragments and corrupt the gate.
#
# With TLS off the gate renders nothing: the (auth) snippet is imported only by
# the HTTPS sites, so AUTH_ENABLED=on with TLS_ENABLED not yes gates nothing
# until TLS is enabled (the installer prints a warning).
#
# With TLS on, the installer fail-closes before rendering: AUTH_ENABLED=on with
# an empty user, hash or cookie secret stops the install and names every missing
# variable.
#
# install.sh generates a strong random cookie signing key automatically when
# HYBRID_AI_AUTH_COOKIE_SECRET is unset, and writes it into the 0600 stack env.
# A value the operator sets is honoured and kept across runs. The value is never
# printed.
#
# The plaintext password and the cookie secret must never enter this file, .env,
# the repository, an argument or git. This gate is ADDITIVE to the Caddy network
# allowlist (`trusted_only`), never a replacement for it.
AUTH_ENABLED=off
HYBRID_AI_AUTH_USER=
HYBRID_AI_AUTH_HASH=
HYBRID_AI_AUTH_COOKIE_SECRET=
# Session lifetime in seconds. 86400 is one day; the auth service uses the same
# default when unset. Rotation means a new secret (every live session drops).
HYBRID_AI_AUTH_COOKIE_MAX_AGE=86400

# --- Cloud inference plane (RunPod) -----------------------------------------
# RUNPOD_HOST is the GPU pod's MagicDNS name and the SINGLE source of the
# pod's identity. Never store the pod's address: a recreated pod gets a new
# one, so a stored copy goes stale. Every consumer resolves this name at use
# time and validates the RESOLVED address against [IP_ADDRESS]/10.
# install.sh discovers RUNPOD_HOST automatically by querying your tailnet.
RUNPOD_HOST=your_runpod_magic_dns_here
PI_HOST=your_pi_magic_dns_here

# RunPod API key, format rpa_...
# Obtain: RunPod console -> Settings -> API Keys
# NOTE: this same key must ALSO be set in the RunPod pod template, so the pod
#       can shut itself down. Two destinations, one key.
RUNPOD_API_KEY=rpa_your_api_key_here

# The pod's ID, visible on the pod card or in the browser URL.
RUNPOD_POD_ID=your_pod_id_here

# Let install.sh start the stopped GPU pod (paid). Only the exact values 1 or
# true enable it; anything else is off. One-off: ./install.sh --wake-runpod
RUNPOD_AUTO_WAKE=0

# Port vLLM listens on inside the pod.
VLLM_PORT=8000

# Model name. MUST match VLLM_MODEL in the RunPod pod template exactly.
VLLM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ

# How long to wait for a cold pod to finish loading, in seconds.
# Cold starts take 2-5 minutes; longer if no persistent volume is attached.
POD_WARMUP_TIMEOUT=600

# --- OpenRouter API (Serverless fallback & agent coding) -------------------
# Used by Open WebUI, OpenHands, and Hermes Agent for low-latency, pay-per-token
# inference without waiting on a cold-starting RunPod GPU instance.
# Obtain: openrouter.ai -> Account -> Keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Default model target on OpenRouter for agentic coding and general orchestration.
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# --- Backups ----------------------------------------------------------------
# NOTE: backup credentials are deliberately NOT stored in this file. They live
# in ~/.config/hybrid-ai-backup/ (mode 0600), outside the git repository, so
# that a compromise of the application stack does not hand over the ability to
# delete your backup history. See backup/README.md.
#
# HYBRID_AI_BACKUP_MODE selects WHICH systemd units run the nightly backup:
#   user   (default) the per-user hybrid-ai-backup.timer, exactly as before
#   system           the two-unit privilege split in backup/system/ (a capture
#                    unit that reads state with one capability and no network,
#                    and an upload unit with credentials and no read privilege)
# Any other value is refused. In system mode the credentials live in the
# root-owned /etc/credstore/hybrid-ai-backup/ instead of ~/.config.
# Leave it commented (or unset) to keep today's behaviour.
#HYBRID_AI_BACKUP_MODE=user
#
# BACKUP_LOG names the backup log file. scripts/lib/hybrid-ai-env.sh resolves
# it once: in user mode it defaults to $HYBRID_AI_LOG_DIR/backup.log, and in
# system mode to the units' LogsDirectory= path /var/log/hybrid-ai-backup/backup.log.
# The backup units, backup.sh, doctor.sh and the status page all read that ONE
# resolved path, so the status page reports the same file the units write. Set
# it only to relocate the log. install.sh writes the resolved value into the
# stack env file; docker-compose.yml fails closed if it is unset.
#BACKUP_LOG=
#
# BACKUP_GROUP_GID is the ONE supplementary group the status container is given,
# so it can read the backup log. In system mode the log is mode 0640 owned by
# hybrid-ai-backup, and this value is that group's gid (resolved by name on the
# host by install.sh). In user mode it is the container's own primary gid, which
# grants no new access. install.sh writes it as ${VAR:-default}, so a value you
# set here survives every reinstall. Do not set it to a group that can read
# anything else you care about: docker-compose.yml fails closed if it is unset.
#BACKUP_GROUP_GID=
#
# BACKUP_CONTAINER_CONTROL tells backup.sh who pauses the containers:
#   self     (default) backup.sh pauses/unpauses Docker itself, as today
#   external a root helper (backup/backup-containers.sh) owns every Docker
#            call, and backup.sh makes none. The system-mode capture unit uses
#            this; a user-mode backup keeps the default.
# Leave it commented (or unset) to keep today's behaviour.
#BACKUP_CONTAINER_CONTROL=self
#
# The credential directory is resolved from HYBRID_AI_BACKUP_MODE with the
# defaults above. To relocate it, set HYBRID_AI_BACKUP_CRED_DIR (absolute path).
#HYBRID_AI_BACKUP_CRED_DIR=


# --- Zero-trace / privacy ---------------------------------------------------
# These disable telemetry and analytics phone-home in the container images.
# Leave all three as-is.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- Peer discovery ---------------------------------------------------------
# Searched in order; first match wins. The legacy name is retained so an
# existing pod keeps working until you rename it.
PEER_HOSTNAME=runpod-worker
PEER_HOSTNAMES=runpod-worker runpod-vllm

# --- Hermes Agent system orchestrator -------------------------------------
# System-wide autonomous agent daemon and WebUI. Manages persistent long-term
# memory (~/.hermes/), acquired skills, and local system tool execution.
HERMES_PORT=8501
HERMES_API_PORT=8642

# Dedicated non-root uid/gid the Hermes image builds and runs as. Leave both
# UNSET to keep the legacy uid 0. The account migration sets them; install.sh
# then refuses to start unless the uid is a no-login system account that owns
# hermes_data. Names only here -- no default, so existing hosts are unchanged.
#HYBRID_AI_UID=
#HYBRID_AI_GID=

# Persistent memory state directory on host. Stores SQLite state, FTS5 indexes,
# and acquired skill files outside the container.
HERMES_DATA_DIR=./hermes_data

# Where the per-user Hermes home lives, captured by the backup. Default is
# ${HOME}/.hermes, exactly where backup.sh and restore.sh already looked. It is
# a named path setting so a system-mode unit can relocate it. Absolute path.
#HYBRID_AI_HERMES_HOME_DIR=

# Resource limits for the background Python daemon and Streamlit WebUI.
HERMES_MEM_LIMIT=2048m
HERMES_CPUS=1.5

# --- OpenHands maintenance agent -------------------------------------------
# Loopback-only UI; reach it with an SSH tunnel over Tailscale.
#
# OPENHANDS_WORKSPACE must NOT be the deployment directory: the agent sandbox
# runs as your uid and would otherwise be able to read this file.
#
# The same clone is ALSO mounted read-only into the Hermes container at
# /agent-repo, so Hermes can read the OpenHands working clone without being
# able to write to it. Both services share the internal `coder-net` network,
# which lets Hermes reach the OpenHands API at http://openhands:3000.
# On a bootstrapped host scripts/bootstrap.sh sets these to the sibling paths
# /var/lib/hybrid-ai-agent and /var/lib/hybrid-ai-repos, owned by the hybrid-ai
# account. They are SIBLINGS of HYBRID_AI_DATA_DIR, never children of it: a path
# inside HYBRID_AI_DATA_DIR is refused by setup-agent-workspace.sh and
# sync-agent-repos.sh.
OPENHANDS_PORT=3001
OPENHANDS_WORKSPACE=/home/youruser/hybrid-ai-agent
OPENHANDS_STATE_DIR=/home/youruser/.openhands
OPENHANDS_MEM_LIMIT=3g
OPENHANDS_CPUS=2.5
# install.sh STEP 2b migrates the stale app-server pin
# docker.openhands.dev/openhands/openhands:1.8 to this value; a pin you
# customise yourself is left untouched (STEP 8 preserves an explicit owner pin).
OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.10
OPENHANDS_AGENT_IMAGE_REPOSITORY=ghcr.io/jimbobsyouruncle/openhands-agent-server-hybrid
# Derived hybrid image. Its shellcheck is pinned to 0.11.0 (at
# /usr/local/bin/shellcheck) and its semgrep to 1.179.0, the same versions the
# CI gates run, so a sandbox on this tag reproduces the gates instead of
# diverging on apt's older shellcheck or on a missing semgrep.
# install.sh STEP 2b migrates the stock default pair, the earlier
# 1.37.1-python-hybrid.1 tag and the 1.37.1-python-hybrid.2 tag to this value;
# a repository or tag you customise yourself is left untouched.
OPENHANDS_AGENT_IMAGE_TAG=1.37.1-python-hybrid.3
# Seconds the app-server gives a new sandbox to answer /health before it marks
# the start terminally ERROR ("500: Sandbox entered error state"). This Pi's
# agent-server boots in ~21s but the app-server's built-in grace is 15s, so a
# start loses that race and fails for good. Raised to 120 to cover the real
# boot time; lower it only if your host boots faster.
OPENHANDS_STARTUP_GRACE_SECONDS=120

# --- Agent repo reference tree (read-only, for Hermes) ----------------------
# scripts/sync-agent-repos.sh keeps a read-only local clone of EVERY non-fork
# repo you own, each on its own default branch, under AGENT_REPOS_DIR. Hermes
# mounts that directory read-only at /agent-repos, so it can read your code and
# any agent-context markdown regardless of which ai/* branch OpenHands last
# left checked out. Refreshed on every deploy, plus whatever timer you install.
#
# AGENT_REPOS_DIR must NOT be, contain, or live inside the deployment directory
# or OPENHANDS_WORKSPACE; the script refuses such a path. Forks are never copied.
# A leading ~ is expanded by the script, so ~/hybrid-ai-repos works here.
AGENT_REPOS_DIR=/home/youruser/hybrid-ai-repos
# Account whose owned, non-fork repos are inventoried. Blank means: derive it
# from the owner in this clone's git origin URL.
AGENT_REPOS_OWNER=
# Optional local manifest (gitignored) listing PRIVATE repos the unauthenticated
# API cannot see, one "OWNER/NAME" per line; prefix a line with "-" to exclude.
# Blank means ./agent-repos.local.
AGENT_REPOS_MANIFEST=
# Freshness window, in hours, for `sync-agent-repos.sh --check`. --check reads
# INVENTORY.md and reports the tree stale once the inventory is older than this.
# Default 48. Set higher to tolerate less frequent syncs.
AGENT_REPOS_MAX_AGE_HOURS=48
# Event logs are verbose and can echo workspace file contents. Enable only
# while debugging, then turn it back off.
OPENHANDS_LOG_ALL_EVENTS=false

# --- Conversation prune (quarantine sweep) ---------------------------------
# scripts/prune-conversations.sh moves stale directories out of
# ${OPENHANDS_WORKSPACE}/conversations/ and into a date-stamped quarantine root.
# Moves are QUARANTINE ONLY: moving a directory back restores it. The one
# deletion is confined to the quarantine root and only past the retention
# window below.
# hybrid-ai-prune.timer runs it daily at 04:20. All values below are optional.
#
# Seconds. A directory whose mtime is newer than this is kept. 604800 = 7 days.
HYBRID_AI_PRUNE_AGE_SECONDS=604800
# Seconds. An expired owner lease is kept until it has been expired this long.
# 86400 = 24 hours.
HYBRID_AI_PRUNE_GRACE_SECONDS=86400
# Count, not seconds. Upper bound on moves in one run; further eligible
# directories are refused with reason=cap-reached.
HYBRID_AI_PRUNE_MAX_MOVES=20
# Override for the quarantine root. When unset it is derived as the sibling
# directory <dirname of HYBRID_AI_DATA_DIR>/hybrid-ai-conversation-quarantine.
# It must stay outside every tree the backup captures, or the sweep moves nothing.
#HYBRID_AI_PRUNE_QUARANTINE_BASE=
# OPT-IN, default empty (OFF). A directory with no owner_lease.json is refused
# forever by the fail-safe, so the sweep reports success while moving nothing.
# Set to 1 to let such a directory move once its own mtime is older than
# HYBRID_AI_PRUNE_AGE_SECONDS. Every other guard still applies. Leave empty to
# keep the fail-safe. `./doctor.sh` warns with the count when this state exists.
#HYBRID_AI_PRUNE_ALLOW_LEASE_LESS=
# Days a <YYYYMMDD> quarantine run directory is kept before the sweep deletes
# it. 90 is the default and retention is ON when this is unset. An explicitly
# EMPTY or 0 value opts out and never deletes anything, as older builds did.
HYBRID_AI_PRUNE_QUARANTINE_RETENTION_DAYS=90

# --- Docker build-cache cap ------------------------------------------------
# scripts/prune-docker-cache.sh caps the Docker BUILD CACHE so repeated rebuilds
# of the multi-GB stack images cannot fill the disk. hybrid-ai-docker-prune.timer
# runs it daily at 04:35. It is CACHE ONLY: it invokes `docker builder prune`
# and nothing else, so it never removes images, containers, volumes, networks or
# bind-mounted data.
#
# Size handed to whichever cap flag the local Docker lists in
# `docker builder prune --help`: --max-used-space when present, else
# --keep-storage. When neither is listed the script logs
# "no supported cache-cap flag" and exits 0. 15GB is the default.
HYBRID_AI_BUILD_CACHE_CAP=15GB

# --- Status page identity ---------------------------------------------------
# Numeric ids, not secrets. install.sh discovers both: your uid, and the group
# that owns the Docker socket on this host (which differs between distros).
STATUS_UID=1000
DOCKER_GID=999

# --- Pipe tuning (optional) -------------------------------------------------
# Read by openwebui/runpod_pipe.py. Every one of these is also exposed in the
# Valves panel in Open WebUI, so you rarely need to set them here.
VLLM_DISPLAY_NAME="Qwen2.5-Coder-32B (RunPod)"
VLLM_REQUEST_TIMEOUT=900
VLLM_MAX_TOKENS=4096
PIPE_LOG_LEVEL=INFO

# --- TLS certificate watchdog (optional) -----------------------------------
# Read by scripts/tls-check.sh (hybrid-ai-tls-check.timer, daily 06:10). These
# only tune the READ-ONLY health check: Caddy alone issues and renews.
# Comma-separated hostnames to probe. When empty, LOCAL_DOMAIN plus hermes. and
# status. are checked.
#TLS_HOSTS=
# HOST:PORT the probe connects to. Defaults to the loopback address on 443.
#TLS_PROBE_ADDR=
# Optional https:// webhook for TLS alerts. Delivered through a private curl
# config, never on a command line; unset means alerts go to journald only.
#HYBRID_AI_ALERT_WEBHOOK_URL=
