# ---------------------------------------------------------------------------
# FILE: .env.example
# PURPOSE (plain English):
#   A reference copy showing every setting the project uses. This file is SAFE
#   to commit because it contains no real credentials -- only placeholders.
#
#   You do NOT need to copy or edit this file. Running ./install.sh generates a
#   real .env for you, prompting for anything it cannot work out by itself.
#   This exists so you can see, at a glance, what the system expects.
#
#   The real .env is gitignored and created with mode 0600 (readable only by
#   your user account). Never commit it.
# ---------------------------------------------------------------------------

# --- Local control plane (Raspberry Pi) ------------------------------------
# Kernel-enforced Docker memory caps. install.sh sizes these from your actual
# RAM. (The old OLLAMA_MAX_VRAM is gone: it never worked and was removed from
# Ollama upstream.)
OLLAMA_MEM_LIMIT=11264m
WEBUI_MEM_LIMIT=3072m

# CPU shares. Leaving a core free keeps the web UI responsive while a model
# is generating.
OLLAMA_CPUS=3.5
WEBUI_CPUS=2.0

# Ollama caps EVERY model at 4096 tokens unless told otherwise, silently
# truncating long chats and RAG context. Larger values cost KV cache memory.
OLLAMA_CONTEXT_LENGTH=16384

OLLAMA_FLASH_ATTENTION=1
# f16 is the default. q8_0 halves KV cache memory, but quantised V cache
# REQUIRES flash attention to be active -- when Ollama auto-disables flash
# attention for an unsupported model architecture, the runner panics instead
# of degrading. Opt in only after confirming your model works with it.
OLLAMA_KV_CACHE_TYPE=f16

# Container image pins. Explicit versions, never :latest, so a `pull` cannot
# swap the image underneath you. Bump deliberately.
# NOTE: OLLAMA_CONTEXT_LENGTH above is honoured only by newer Ollama servers.
# install.sh checks this after start and warns.
OLLAMA_IMAGE=ollama/ollama:0.34.4
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4

# Serve one request at a time. A Pi has no headroom for parallelism.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# How long an idle model stays resident. Longer means faster follow-up
# questions; install.sh uses 30m on a 16 GB board.
OLLAMA_KEEP_ALIVE=30m

# --- Open WebUI -------------------------------------------------------------
# Signs your login cookies. install.sh generates this once with
# `openssl rand -hex 32` and then reuses it forever. If this value ever
# changes, every user is logged out.
WEBUI_SECRET_KEY=generated_automatically_do_not_set_manually

# Require login. Leave as true.
WEBUI_AUTH=true

# Model used to turn your documents into searchable vectors. Runs locally.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Leave false unless you deliberately want to add external API providers.
ENABLE_OPENAI_API=false

# --- Cloud inference plane (RunPod) -----------------------------------------
# The GPU pod's private Tailscale address. MUST begin with 100.
# install.sh discovers this automatically by querying your tailnet.
TAILSCALE_IP=100.64.0.0

# RunPod API key, format rpa_...
# Obtain: RunPod console -> Settings -> API Keys
# NOTE: this same key must ALSO be set in the RunPod pod template, so the pod
#       can shut itself down. Two destinations, one key.
RUNPOD_API_KEY=rpa_your_api_key_here

# The pod's ID, visible on the pod card or in the browser URL.
RUNPOD_POD_ID=your_pod_id_here

# Port vLLM listens on inside the pod.
VLLM_PORT=8000

# Model name. MUST match VLLM_MODEL in the RunPod pod template exactly.
VLLM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ

# How long to wait for a cold pod to finish loading, in seconds.
# Cold starts take 2-5 minutes; longer if no persistent volume is attached.
POD_WARMUP_TIMEOUT=600

# --- Backups ----------------------------------------------------------------
# NOTE: backup credentials are deliberately NOT stored in this file. They live
# in ~/.config/hybrid-ai-backup/ (mode 0600), outside the git repository, so
# that a compromise of the application stack does not hand over the ability to
# delete your backup history. See backup/README.md.

# --- Zero-trace / privacy ---------------------------------------------------
# These disable telemetry and analytics phone-home in the container images.
# Leave all three as-is.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- Peer discovery ---------------------------------------------------------
# Searched in order; first match wins. The legacy name is retained so an
# existing pod keeps working until you rename it.
PEER_HOSTNAME=runpod-worker
PEER_HOSTNAMES=runpod-worker runpod-vllm

# --- OpenHands maintenance agent -------------------------------------------
# Loopback-only UI; reach it with an SSH tunnel over Tailscale.
#
# OPENHANDS_WORKSPACE must NOT be the deployment directory: the agent sandbox
# runs as your uid and would otherwise be able to read this file.
OPENHANDS_PORT=3001
OPENHANDS_WORKSPACE=/home/youruser/hybrid-ai-agent
OPENHANDS_STATE_DIR=/home/youruser/.openhands
OPENHANDS_MEM_LIMIT=2g
OPENHANDS_CPUS=1.5
OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.8
OPENHANDS_AGENT_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
OPENHANDS_AGENT_IMAGE_TAG=1.26.0-python
# Event logs are verbose and can echo workspace file contents. Enable only
# while debugging, then turn it back off.
OPENHANDS_LOG_ALL_EVENTS=false

# --- Status page identity ---------------------------------------------------
# Numeric ids, not secrets. install.sh discovers both: your uid, and the group
# that owns the Docker socket on this host (which differs between distros).
STATUS_UID=1000
DOCKER_GID=999

# --- Pipe tuning (optional) -------------------------------------------------
# Read by openwebui/runpod_pipe.py. Every one of these is also exposed in the
# Valves panel in Open WebUI, so you rarely need to set them here.
VLLM_DISPLAY_NAME="Qwen2.5-Coder-32B (RunPod)"
VLLM_REQUEST_TIMEOUT=900
VLLM_MAX_TOKENS=4096
PIPE_LOG_LEVEL=INFO
