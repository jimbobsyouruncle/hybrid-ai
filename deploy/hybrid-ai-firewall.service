# ---------------------------------------------------------------------------
# FILE: deploy/hybrid-ai-firewall.service
# PURPOSE (plain English):
#   Re-applies the sandbox firewall rules on every boot. Docker creates the
#   DOCKER-USER chain when it starts, so the rules cannot simply be baked in at
#   install time; they have to be re-added after Docker is up. This unit does
#   that after every reboot.
#
#   It installs the three tagged rules scripts/sandbox-firewall.sh owns: one
#   ACCEPT for the docker0-gateway webhook path on the OpenHands port, and two
#   DROPs that keep sandbox ports off the LAN and keep sandboxes off the other
#   Docker networks. The script is idempotent and never touches a foreign rule,
#   so running it again after a manual apply is a no-op.
#
#   It runs AFTER docker.service and Wants= it, so DOCKER-USER exists. If Docker
#   still has not created the chain, the script exits 4 with a clear message and
#   the unit fails loudly rather than pretending the host is protected. That is
#   deliberate: a silent success here would leave the sandbox ports open.
#
#   BOOT-ONLY. The unit is enabled by scripts/bootstrap.sh and by nothing else.
#   The privileged deploy path (install.sh, scripts/deploy-remote.sh) calls the
#   script directly, after the compose stack is up.
#
#   NO Restart= AT ALL, for the same reason as the deploy unit: a retry loop on
#   a firewall unit can flap the host's filter table. A failure stays visible in
#   `systemctl status hybrid-ai-firewall`.
# ---------------------------------------------------------------------------
[Unit]
Description=hybrid-ai sandbox firewall (DOCKER-USER drops)
Documentation=file:///opt/hybrid-ai/deploy/README.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# DOCKER-USER is root-owned; adding rules needs root.
User=root
WorkingDirectory=/opt/hybrid-ai
# No leading "-": a failed apply must fail the unit.
ExecStart=/opt/hybrid-ai/scripts/sandbox-firewall.sh apply

# Deliberately NO Restart= policy. See the file header.

[Install]
WantedBy=multi-user.target
