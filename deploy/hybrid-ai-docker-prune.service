# ---------------------------------------------------------------------------
# FILE: deploy/hybrid-ai-docker-prune.service
# PURPOSE (plain English):
#   Runs the Docker build-cache prune once, on demand, as root. The script
#   scripts/prune-docker-cache.sh caps the Docker BUILD CACHE so repeated
#   rebuilds of the multi-GB stack images cannot fill the disk. It is CACHE
#   ONLY: it never removes images, containers, volumes, networks or
#   bind-mounted data.
#
#   It runs as root because it talks to the Docker socket, exactly like the
#   sibling hybrid-ai-prune.service.
#
#   SCHEDULE: the timer hybrid-ai-docker-prune.timer is the primary mechanism
#   and runs this unit daily at 04:35. There is no deploy-time catch-up run.
#
#   NO Restart= AT ALL, deliberately: a failing prune must not loop. A failure
#   stays visible in `systemctl status hybrid-ai-docker-prune`.
#
#   EnvironmentFile has the "-" prefix so a missing /opt/hybrid-ai/.env is not
#   fatal: the script then uses its own 15 GB default. The script logs only the
#   cap value; it never echoes any other .env entry.
# ---------------------------------------------------------------------------
[Unit]
Description=hybrid-ai Docker build-cache prune (cap the build cache, cache only)
Documentation=file:///opt/hybrid-ai/deploy/README.md
After=docker.service

[Service]
Type=oneshot
# The prune talks to the Docker socket, which is root-owned.
User=root
WorkingDirectory=/opt/hybrid-ai
EnvironmentFile=-/opt/hybrid-ai/.env
ExecStart=/opt/hybrid-ai/scripts/prune-docker-cache.sh

# Deliberately NO Restart= policy: a failing prune must not loop. See the header.

[Install]
WantedBy=multi-user.target
